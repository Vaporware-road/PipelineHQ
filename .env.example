DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me-forgecrm-secret
POSTGRES_DB=forgecrm
POSTGRES_USER=samlv
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_LAYER_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STALE_DEAL_DAYS=14
QUOTE_DISCOUNT_APPROVAL_PCT=20
# Empty = Mini App / browser use same-origin /api (Next rewrites to Django).
# For a second API tunnel set e.g. NEXT_PUBLIC_API_URL=https://<api-tunnel>
NEXT_PUBLIC_API_URL=
# Optional WebSocket origin (defaults: localhost → ws://127.0.0.1:8000):
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# AI assists (optional). Rules always work offline; set key for LLM overlay:
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# Email — console by default; for Mailtrap/SMTP set EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend and fill host credentials:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=PipelineHQ <noreply@pipelinehq.local>
# Telegram Mini App (optional — leave empty until BotFather is configured):
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Public HTTPS Mini App URL (tunnel → frontend :3000), e.g. https://<id>.trycloudflare.com/tma
TELEGRAM_WEBAPP_URL=
TELEGRAM_BOT_ENABLED=1
# Same as TELEGRAM_BOT_USERNAME (no @). Used for t.me deep links in the Mini App UI.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
